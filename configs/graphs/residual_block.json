      "attrs": {"in_channels": 64, "out_channels": 64, "kernel": [3, 3], "groups": 1}
    },
    {
      "name": "bn1",
      "op": "batch_norm",
      "inputs": ["conv1"],
      "output_shape": [1, 64, 56, 56],
